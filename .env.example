# =====================================================================
# BreachGraph: Environment Configuration
# =====================================================================

# 1. Google Gemini API Key (Required for Agent Reasoning)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. FalkorDB Connection Settings
# Works seamlessly with Local Docker OR free FalkorDB Cloud (https://app.falkordb.cloud)

# For Local Docker:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_USERNAME=

# For FalkorDB Cloud (Uncomment and populate if using Cloud):
# FALKORDB_HOST=your-cluster-id.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=your_cloud_password
# FALKORDB_USERNAME=default

# 3. Graph Database Name
FALKORDB_GRAPH_NAME=BreachGraph
